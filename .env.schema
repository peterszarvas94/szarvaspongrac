# @plugin(@varlock/1password-plugin@1.1.0)
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @initOp(token=$OP_TOKEN, allowAppAuth=forEnv(development))
# ---
# 1Password layout (create these yourself):
#   vault: szarvaspongrac
#   item:  production_token  → field credential (service account token)
#   item:  production         → fields matching sensitive keys below

# @type=opServiceAccountToken
OP_TOKEN=

# @type=enum(development, production)
# @sensitive=false
APP_ENV=development

# @type=string
# @sensitive=false
PORT=4321

# @type=url
# @sensitive=false
PB_URL=http://127.0.0.1:8090

# @type=url
# @sensitive=false
PUBLIC_URL=ifs(eq($APP_ENV, production), https://szarvaspongrac.hu, http://localhost:4321)

# @required=forEnv(production)
# @sensitive
SESSION_SECRET=ifs(eq($APP_ENV, production), op("op://szarvaspongrac/production/SESSION_SECRET"), "dev-secret-change-in-production")
