package shared

import (
	icons "szarvaspongrac/templates/shared/icons"
	view "szarvaspongrac/views/pages"
)

templ DevCredit() {
	<section class="flex flex-wrap justify-center items-center py-4 px-4 sm:px-6 md:px-8 gap-2 text-base-content/60 text-sm">
		@icons.Code(templ.Attributes{"class": "icon"})
		<p>A weboldal fejlesztője:</p>
		<a
			href="https://peterszarvas.hu"
			target="_blank"
			rel="noopener noreferrer"
			class="hover:link hover:text-base-content"
		>
			https://peterszarvas.hu
		</a>
	</section>
}

templ PageFooter(data view.PageData) {
	if data.FooterBackHref != "" {
		<section class="flex flex-wrap justify-center items-center py-4 px-4 sm:px-6 md:px-8">
			<a href={ templ.SafeURL(data.FooterBackHref) } class="btn btn-soft gap-2">
				@icons.ArrowLeft(templ.Attributes{"class": "icon"})
				<span>{ data.FooterBackText }</span>
			</a>
		</section>
	}
	@Footer(data)
}

templ FooterLink(href string, text string, icon icons.IconName) {
	<a
		href={ templ.SafeURL(href) }
		class="flex items-center hover:link hover:text-base-content text-sm transition-colors gap-1"
	>
		@icons.Icon(icon, templ.Attributes{"class": "icon"})
		if text != "" {
			<span>{ text }</span>
		}
	</a>
}

templ Footer(data view.PageData) {
	<footer class="bg-base-300 border-t border-base-300 text-base-content/70 text-sm h-24 sm:h-20 md:h-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 flex flex-col items-center justify-center md:flex-row md:justify-between gap-1 h-full">
			<div class="flex items-center justify-center gap-1 flex-wrap">
				@icons.Copyright(templ.Attributes{"class": "icon"})
				<span>{ CopyrightNotice() }</span>
			</div>
			<div class="flex flex-col items-center gap-1 sm:gap-4 sm:flex-row">
				if data.FooterEmail.URL != "" {
					@FooterLink(data.FooterEmail.URL, data.FooterEmail.Text, icons.IconMail)
				}
				if data.FooterPhone.URL != "" {
					@FooterLink(data.FooterPhone.URL, data.FooterPhone.Text, icons.IconPhone)
				}
				@FooterLink("/admin", "", icons.IconSettings)
			</div>
		</div>
	</footer>
}
