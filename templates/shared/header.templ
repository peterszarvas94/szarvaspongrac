package shared

import icons "szarvaspongrac/templates/shared/icons"

templ Header() {
	<header class="sticky top-0 z-50 bg-base-100 shadow-sm border-b border-base-300 h-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex justify-between items-center">
			<a
				href="/"
				class="text-2xl font-bold hover:link"
				title="Kezdőlap"
				aria-label="Kezdőlap"
			>
				Szarvas Pongrác
			</a>
			<nav class="hidden lg:flex gap-8 text-sm font-medium text-base-content/70">
				for _, item := range NavItems() {
					<a href={ item.Href } class="hover:link">{ item.Label }</a>
				}
			</nav>
			<details class="dropdown dropdown-end lg:hidden">
				<summary
					class="btn btn-ghost btn-circle"
					aria-label="Menü"
				>
					@icons.Menu(templ.Attributes{"class": "w-6 h-6"})
				</summary>
				<ul class="menu dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow-sm">
					for _, item := range NavItems() {
						<li><a href={ item.Href }>{ item.Label }</a></li>
					}
				</ul>
			</details>
		</div>
	</header>
}
