package pages

import (
	"szarvaspongrac/templates/shared"
	icons "szarvaspongrac/templates/shared/icons"
	view "szarvaspongrac/views/pages"
)

templ Admin(data view.AdminData) {
	@shared.Layout(data.PageData, "py-4") {
		@shared.PageTitle("Admin")
		<div class="mx-auto w-full max-w-md">
			<div class="card bg-base-100 shadow-xl">
				<div class="card-body">
					if !data.Authed {
						<h2 class="card-title justify-center text-2xl mb-6">Bejelentkezés</h2>
						<form method="POST" action="/auth/login" class="flex flex-col gap-4">
							<div>
								<div class="flex items-center gap-2 mb-2">
									@icons.Mail(templ.Attributes{"class": "w-4 h-4 text-primary"})
									<label class="label-text font-medium">Email</label>
								</div>
								<input
									type="email"
									name="email"
									class="input input-bordered input-primary w-full"
									placeholder="email@example.com"
									required
									autocomplete="email"
								/>
							</div>
							<div>
								<div class="flex items-center gap-2 mb-2">
									@icons.Lock(templ.Attributes{"class": "w-4 h-4 text-primary"})
									<label class="label-text font-medium">Jelszó</label>
								</div>
								<input
									type="password"
									name="password"
									class="input input-bordered input-primary w-full"
									placeholder="••••••••"
									required
									autocomplete="current-password"
								/>
							</div>
							<button type="submit" class="btn btn-primary btn-block">Bejelentkezés</button>
						</form>
					} else {
						@icons.User(templ.Attributes{"class": "w-16 h-16 mx-auto text-primary mb-4"})
						<h2 class="card-title justify-center text-2xl mb-2">Üdvözöljük!</h2>
						<p class="text-center mb-6">{ data.Email }</p>
						<form method="POST" action="/auth/logout">
							<button type="submit" class="btn btn-outline btn-error btn-block">
								@icons.LogOut(templ.Attributes{"class": "icon mr-2"})
								<span>Kijelentkezés</span>
							</button>
						</form>
					}
				</div>
			</div>
		</div>
	}
}
