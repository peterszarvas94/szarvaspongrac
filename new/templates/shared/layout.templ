package shared

import (
	"szarvaspongrac/utils"
	view "szarvaspongrac/views/pages"
)

templ Layout(data view.PageData, mainClass string) {
	{{
		tabID := utils.EnsureTabIDFromContext(ctx)
		pageState := utils.GetPageState(tabID)
		signals := utils.PageSignals(pageState, tabID)
	}}
	<!DOCTYPE html>
	<html lang="hu" data-theme="light" class="bg-base-200">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ data.Description }/>
			<title>{ data.Title }</title>
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
			<link rel="stylesheet" href="/static/css/generated.css"/>
			<link rel="stylesheet" href="/static/css/tiptap.css"/>
			<script type="importmap">
				{"imports":{"datastar":"/static/js/vendor/datastar.js","tiptap-bundle":"/static/js/vendor/tiptap.js"}}
			</script>
			<script type="module" src="/static/js/main.js"></script>
			<script type="module" src="/static/js/notifications.js"></script>
		</head>
		<body class="bg-base-200 relative font-inter" data-tab-id={ tabID } data-signals={ templ.JSONString(signals) } data-init="@get('/sse')">
			@Header()
			<div class="page flex flex-col min-h-[calc(100vh-4rem)] justify-between">
				<main class={ "flex flex-col flex-1 " + mainClass }>
					{ children... }
				</main>
				@PageFooter(data)
			</div>
			@Notifications()
			@ConfirmDialog()
		</body>
	</html>
}
