package shared

templ Header() {
	<header class="sticky top-0 z-50 bg-base-100 shadow-sm border-b border-base-300 h-16">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex justify-between items-center">
			<a href="/" class="text-2xl font-bold hover:link">Szarvas Pongrác</a>
			<nav class="hidden lg:flex gap-8 text-sm font-medium text-base-content/70">
				<a href="/oneletrajz" class="hover:link">Önéletrajz</a>
				<a href="/elismeresek" class="hover:link">Elismerések</a>
				<a href="/konyvillusztraciok" class="hover:link">Könyvillusztrációk</a>
				<a href="/galeria" class="hover:link">Galéria</a>
				<a href="/kapcsolat" class="hover:link">Kapcsolat</a>
			</nav>
		</div>
	</header>
}
