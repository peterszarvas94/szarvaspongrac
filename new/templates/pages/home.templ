package pages

import (
	"szarvaspongrac/templates/shared"
	icons "szarvaspongrac/templates/shared/icons"
	view "szarvaspongrac/views/pages"
)

templ HomeAdmin(data view.HomeAdminData) {
	<div id="home-admin">
		if data.Authed {
			<div class="w-full py-4 flex justify-center gap-2">
				if !data.EditMode {
					<button type="button" class="btn gap-2" data-on:click="$action='enter', $contentKey='home.home', @patch('/state/edit')">
						@icons.Pencil(templ.Attributes{"class": "icon"})
						<span>Szerkesztés</span>
					</button>
				} else {
					<button type="button" class="btn gap-2" data-on:click="$action='exit', $contentKey='home.home', @patch('/state/edit')">
						@icons.X(templ.Attributes{"class": "icon"})
						<span>Kilépés</span>
					</button>
				}
			</div>
			@shared.HeroImageUpload(data.ContentKey, data.EditMode)
		}
	</div>
}

templ Home(data view.HomeData) {
	@shared.Layout(data.PageData, "") {
		@HeroSection(data.HeroURL)
		@HomeAdmin(view.HomeAdminData{
			ContentKey: data.ContentKey,
			Authed:     data.Authed,
			EditMode:   data.EditMode,
		})
		<section class="py-8 bg-base-200">
			<div class="mx-auto px-4 flex gap-4 flex-row flex-wrap items-center justify-center">
				@shared.NavigationCard("/oneletrajz", "Önéletrajz", "primary", icons.IconFileUser)
				@shared.NavigationCard("/elismeresek", "Elismerések", "warning", icons.IconTrophy)
				@shared.NavigationCard("/konyvillusztraciok", "Könyvillusztrációk", "success", icons.IconBookImage)
				@shared.NavigationCard("/galeria", "Galéria", "secondary", icons.IconPalette)
				@shared.NavigationCard("/kapcsolat", "Kapcsolat", "accent", icons.IconMail)
			</div>
		</section>
	}
}

templ HeroSection(heroURL string) {
	<section
		id="hero-section"
		class={ "relative min-h-[70vh] bg-neutral-800 bg-cover bg-center flex items-center justify-center " + heroOverlayClass(heroURL) }
		style={ heroBgStyle(heroURL) }
	>
		<div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
			<h1 class="text-7xl text-base-100 mb-6">Szarvas Pongrác</h1>
			<p class="text-lg text-base-100/80">Grafikus • Illusztrátor • Festő</p>
			<p class="text-lg text-base-100/80">Wildlife artist</p>
		</div>
	</section>
}
